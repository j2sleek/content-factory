# Content Factory Environment Variables

# Google Cloud
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# Apps Script Router
APPS_SCRIPT_ROUTER_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Google Sheets
SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Cloud Functions URLs
SCRAPER_CF_URL=https://REGION-PROJECT_ID.cloudfunctions.net/scraper
NORMALIZER_CF_URL=https://REGION-PROJECT_ID.cloudfunctions.net/normalizer

# GitHub
GITHUB_TOKEN=your_github_pat
GITHUB_REPO=owner/repo

# opencode (if using Render)
OPENCODE_WEBHOOK_URL=https://your-opencode.onrender.com/generate
OPENCODE_MODEL=big-pickle

# Render (optional)
RENDER_API_KEY=your_render_api_key
RENDER_SERVICE_ID=your_service_id
